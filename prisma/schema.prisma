generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// ----------------------------------------------------
// 1. ORGANIZATIONS & USERS (Agency Level)
// ----------------------------------------------------

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logoUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  members     OrganizationMember[]
  clients     Client[]
  activityLogs ActivityLog[]
}

model User {
  id              String         @id @default(cuid())
  organizationId  String
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email           String         @unique
  name            String
  passwordHash    String
  role            String         @default("ACCOUNT_MANAGER") // OWNER, ADMIN, ACCOUNT_MANAGER, CONTENT_CREATOR, APPROVER, SALES, VIEWER
  avatarUrl       String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  orgMemberships    OrganizationMember[]
  clientMemberships ClientMember[]
  activityLogs      ActivityLog[]

  @@index([organizationId])
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("ACCOUNT_MANAGER")
  createdAt      DateTime     @default(now())

  @@unique([organizationId, userId])
  @@index([userId])
}

// ----------------------------------------------------
// 2. CLIENT WORKSPACE & MEMBERSHIP
// ----------------------------------------------------

model Client {
  id              String         @id @default(cuid())
  organizationId  String
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  name            String         // e.g. "UXUI HOLDINGS"
  brandName       String?
  slug            String         @unique
  logoUrl         String?
  industry        String         // e.g. "Industrial / Metal Fabrication"
  locationCity    String         // e.g. "Klang"
  locationState   String         // e.g. "Selangor"
  locationCountry String         @default("Malaysia")
  status          String         @default("ACTIVE") // ACTIVE, ONBOARDING, PAUSED, ARCHIVED

  accountManagerId String?
  accountManagerName String?
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  members           ClientMember[]
  profile           ClientProfile?
  services          ClientService[]
  targetMarket      ClientTargetMarket?
  brandProfile      ClientBrandProfile?
  marketingObjectives ClientMarketingObjective[]
  competitors       ClientCompetitor[]
  notes             ClientNote[]
  strategy          ClientStrategy?
  socialAccounts    SocialAccount[]
  campaigns         Campaign[]
  contentItems      ContentItem[]
  postVariants      PostVariant[]
  contentVersions   ContentVersion[]
  approvalRequests  ApprovalRequest[]
  referenceAssets   ClientReferenceAsset[]
  aiGenerationLogs  AiGenerationLog[]
  mediaAssets       MediaAsset[]
  activityLogs      ActivityLog[]

  @@index([organizationId])
  @@index([status])
}

model ClientMember {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("ACCOUNT_MANAGER")
  createdAt DateTime @default(now())

  @@unique([clientId, userId])
  @@index([userId])
}

// ----------------------------------------------------
// 3. CLIENT PROFILE SECTIONS
// ----------------------------------------------------

model ClientProfile {
  id                  String   @id @default(cuid())
  clientId            String   @unique
  client              Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  businessDescription String?
  website             String?
  phone               String?
  whatsapp            String?
  email               String?
  address             String?
  city                String?
  state               String?
  country             String?  @default("Malaysia")
  serviceAreas        String?  // JSON string or comma-separated
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model ClientService {
  id              String   @id @default(cuid())
  clientId        String
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name            String   // e.g. "Laser Cutting"
  category        String   // e.g. "Metal Fabrication"
  description     String
  sellingPoints   String   // JSON string array e.g. '["High precision","Fast production"]'
  targetCustomers String   // JSON string array e.g. '["Factories","Automation companies"]'
  priceInfo       String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([clientId])
}

model ClientTargetMarket {
  id                  String   @id @default(cuid())
  clientId            String   @unique
  client              Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  geographicTarget    String   // e.g. "Malaysia, Singapore"
  industryTarget      String   // e.g. "Automation, Metal Fabrication"
  customerType        String   // "B2B", "B2C", "B2B2C"
  languages           String   // JSON string array e.g. '["English","Bahasa Melayu","Chinese"]'
  ageRange            String?
  buyerPersona        String?
  decisionMakers      String   // JSON string array e.g. '["Purchasing Manager","Engineering Manager"]'
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model ClientBrandProfile {
  id                String   @id @default(cuid())
  clientId          String   @unique
  client            Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  brandPositioning  String?
  brandTone         String?  // e.g. "Authoritative, Industrial, Reliable"
  preferredLanguage String   @default("English")
  secondaryLanguage String?
  visualStyle       String?
  brandColours      String   @default("[]") // JSON string array of hex colours e.g. '["#0F172A","#2563EB"]'
  avoidedWords      String   @default("[]") // JSON string array e.g. '["cheap","discount"]'
  preferredCta      String?  // e.g. "Request an Engineering Consultation"
  companySlogan     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model ClientMarketingObjective {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title       String   // e.g. "Generate WhatsApp enquiries"
  description String?
  priority    Int      @default(1)
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([clientId])
}

model ClientCompetitor {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name        String
  website     String?
  facebookUrl String?
  instagramUrl String?
  tiktokUrl   String?
  notes       String?
  createdAt   DateTime @default(now())

  @@index([clientId])
}

model ClientNote {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  authorName  String   @default("Agency Account Team")
  title       String
  content     String
  isPinned    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([clientId])
}

// ----------------------------------------------------
// 4. CLIENT STRATEGY & CONTENT PILLARS
// ----------------------------------------------------

model ClientStrategy {
  id                  String   @id @default(cuid())
  clientId            String   @unique
  client              Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  brandPositioning    String?
  marketingObjectives String?
  targetAudience      String?
  targetLocations     String?
  targetIndustries    String?
  mainProductsServices String?
  keySellingPoints    String?
  preferredPlatforms  String   @default("[\"Facebook\",\"Instagram\"]") // JSON array
  postingFrequency    String?  // e.g. "4 posts / week"
  languageStrategy    String?
  ctaStrategy         String?
  campaignPriorities  String?
  specialInstructions String?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  pillars             ContentPillar[]
}

model ContentPillar {
  id          String         @id @default(cuid())
  strategyId  String
  strategy    ClientStrategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  title       String         // e.g. "Laser Cutting"
  description String?
  isActive    Boolean        @default(true)
  orderIndex  Int            @default(0)
  createdAt   DateTime       @default(now())

  contentItems ContentItem[]

  @@index([strategyId])
}

// ----------------------------------------------------
// 5. SOCIAL ACCOUNTS (Isolated & Encrypted Tokens)
// ----------------------------------------------------

model SocialAccount {
  id                         String           @id @default(cuid())
  organizationId             String?
  clientId                   String
  client                     Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  platform                   String           // FACEBOOK, INSTAGRAM, TIKTOK
  provider                   String           @default("META") // META, TIKTOK
  
  platformAccountId          String?          // Page ID or Instagram Account ID
  platformParentAccountId    String?          // e.g. Linked Facebook Page ID for Instagram
  
  displayName                String?          // e.g. "UXUI Holdings Official"
  username                   String?          // e.g. "@uxuiholdings"
  profileImageUrl            String?
  
  connectionStatus           String           @default("NOT_CONNECTED") // NOT_CONNECTED, CONNECTING, CONNECTED, TOKEN_EXPIRED, PERMISSION_ERROR, REAUTH_REQUIRED, DISCONNECTED, ERROR
  accountType                String?          // PAGE, BUSINESS, CREATOR
  isPrimary                  Boolean          @default(true)
  
  // Encrypted at rest (AES-256-GCM) - Never returned to browser client
  accessTokenEncrypted       String?
  refreshTokenEncrypted      String?
  tokenExpiresAt             DateTime?
  
  permissionsGranted         String?          // JSON array of granted permission strings
  providerMetadata           String?          // JSON metadata e.g. tasks, category, ig_id
  
  connectedBy                String?          // Name of the user who authorized
  connectedAt                DateTime?
  lastVerifiedAt             DateTime?
  
  createdAt                  DateTime         @default(now())
  updatedAt                  DateTime         @updatedAt

  @@index([clientId])
  @@index([platform])
  @@index([platformAccountId])
  @@index([organizationId])
}

// ----------------------------------------------------
// 6. CONTENT, CALENDAR, MEDIA & CAMPAIGNS
// ----------------------------------------------------

model Campaign {
  id              String        @id @default(cuid())
  organizationId  String?
  clientId        String
  client          Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  objective       String?
  targetAudience  String?
  keyMessage      String?
  cta             String?
  startDate       DateTime?
  endDate         DateTime?
  status          String        @default("ACTIVE") // DRAFT, ACTIVE, PAUSED, COMPLETED, ARCHIVED
  createdBy       String        @default("Agency Team")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  contentItems    ContentItem[]

  @@index([clientId])
  @@index([status])
}

model ContentItem {
  id                String        @id @default(cuid())
  organizationId    String?
  clientId          String
  client            Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  campaignId        String?
  campaign          Campaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  contentPillarId   String?
  contentPillarRel  ContentPillar? @relation(fields: [contentPillarId], references: [id], onDelete: SetNull)
  
  title             String
  description       String?
  internalBrief     String?
  coreMessage       String?
  objective         String?
  contentPillar     String?       // Content pillar title or tag
  
  contentType       String        @default("IMAGE") // IMAGE, CAROUSEL, VIDEO, REEL, SHORT_VIDEO, TEXT, STORY, OTHER
  status            String        @default("DRAFT") // DRAFT, GENERATING, READY_FOR_REVIEW, CHANGES_REQUESTED, APPROVED, READY_TO_SCHEDULE, SCHEDULED, PUBLISHED, FAILED, ARCHIVED
  
  targetAudience    String?
  targetLocation    String?
  callToAction      String?
  productsServices  String?
  
  platforms         String        @default("[\"FACEBOOK\"]") // JSON array of platforms e.g. ["FACEBOOK","INSTAGRAM","TIKTOK"]
  mediaUrls         String        @default("[]") // JSON array of media URLs or IDs
  internalNotes     String?
  
  scheduledFor      DateTime?
  publishedAt       DateTime?
  
  createdBy         String        @default("Agency Team")
  assignedTo        String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  variants          PostVariant[]
  versions          ContentVersion[]
  approvalRequests  ApprovalRequest[]
  aiLogs            AiGenerationLog[]

  @@index([clientId])
  @@index([status])
  @@index([scheduledFor])
  @@index([campaignId])
}

model PostVariant {
  id                String          @id @default(cuid())
  organizationId    String?
  clientId          String
  client            Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contentItemId     String
  contentItem       ContentItem     @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  
  platform          String          // FACEBOOK, INSTAGRAM, TIKTOK
  headline          String?
  hook              String?
  caption           String
  cta               String?
  hashtags          String?
  
  onScreenText      String?         // for TikTok video overlay
  videoIdea         String?         // for TikTok production brief
  platformNotes     String?
  mediaSelection    String          @default("[]") // JSON array of media URLs
  
  language          String          @default("English") // English, Bahasa Malaysia, Chinese, English + Chinese, English + BM
  generationStatus  String          @default("IDLE") // IDLE, GENERATING, GENERATED, FAILED
  approvalStatus    String          @default("PENDING") // PENDING, APPROVED, REJECTED, CHANGES_REQUESTED
  
  versionNumber     Int             @default(1)
  isEditedManually  Boolean         @default(false)
  
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  versions          ContentVersion[]

  @@index([contentItemId])
  @@index([clientId])
  @@index([platform])
}

model ContentVersion {
  id                String          @id @default(cuid())
  organizationId    String?
  clientId          String
  client            Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contentItemId     String
  contentItem       ContentItem     @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  postVariantId     String?
  postVariant       PostVariant?    @relation(fields: [postVariantId], references: [id], onDelete: SetNull)
  
  versionNumber     Int
  contentSnapshot   String          // JSON snapshot of content and platform variant copy
  changeSummary     String?
  
  createdBy         String
  createdAt         DateTime        @default(now())

  @@index([contentItemId])
  @@index([postVariantId])
  @@index([clientId])
}

model ApprovalRequest {
  id                String          @id @default(cuid())
  organizationId    String?
  clientId          String
  client            Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contentItemId     String
  contentItem       ContentItem     @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  
  platformScope     String          @default("ALL") // ALL, FACEBOOK, INSTAGRAM, TIKTOK
  requestedBy       String
  assignedApprover  String?
  status            String          @default("PENDING") // PENDING, APPROVED, REJECTED, CHANGES_REQUESTED
  
  submittedAt       DateTime        @default(now())
  reviewedAt        DateTime?
  reviewedBy        String?
  reviewComment     String?

  comments          ApprovalComment[]

  @@index([contentItemId])
  @@index([clientId])
  @@index([status])
}

model ApprovalComment {
  id                String          @id @default(cuid())
  organizationId    String?
  clientId          String
  approvalRequestId String
  approvalRequest   ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
  
  userId            String
  userName          String
  comment           String
  createdAt         DateTime        @default(now())

  @@index([approvalRequestId])
  @@index([clientId])
}

model ClientReferenceAsset {
  id                  String        @id @default(cuid())
  organizationId      String?
  clientId            String
  client              Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  name                String
  type                String        // PDF, BROCHURE, PRODUCT_SHEET, BRAND_GUIDE
  fileUrl             String
  purpose             String?
  isAiApprovedSource  Boolean       @default(true)
  
  uploadedBy          String        @default("Agency Team")
  createdAt           DateTime      @default(now())

  @@index([clientId])
}

model AiGenerationLog {
  id                  String        @id @default(cuid())
  organizationId      String?
  clientId            String
  client              Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contentItemId       String?
  contentItem         ContentItem?  @relation(fields: [contentItemId], references: [id], onDelete: SetNull)
  
  provider            String        @default("GEMINI")
  model               String        @default("gemini-2.5-flash")
  action              String        // GENERATE_ALL, GENERATE_SINGLE, REWRITE, QUALITY_CHECK
  sourceContextIds    String?       // JSON array of service/pillar/reference asset IDs used
  promptVersion       String        @default("content-v1")
  
  inputTokens         Int           @default(0)
  outputTokens        Int           @default(0)
  
  createdBy           String
  createdAt           DateTime      @default(now())

  @@index([clientId])
  @@index([contentItemId])
}

model MediaAsset {
  id           String   @id @default(cuid())
  clientId     String
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  fileName     String
  fileUrl      String
  thumbnailUrl String?
  fileType     String   // "image/png", "video/mp4", "application/pdf"
  fileSize     Int      @default(0)
  category     String   @default("Images") // Images, Videos, Brand Assets, Documents
  tags         String   @default("[]") // JSON string array
  uploadedBy   String   @default("Agency Team")
  createdAt    DateTime @default(now())

  @@index([clientId])
  @@index([category])
}

model ActivityLog {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  clientId       String?
  client         Client?       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  action         String        // e.g. "CLIENT_CREATED", "PROFILE_UPDATED", "CONTENT_CREATED"
  entityType     String?       // e.g. "CLIENT", "CONTENT", "SERVICE", "STRATEGY"
  entityId       String?
  metadata       String?       // JSON metadata
  description    String
  createdAt      DateTime      @default(now())

  @@index([organizationId])
  @@index([clientId])
  @@index([userId])
}
